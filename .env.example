# Copy this file to .env and replace the placeholder password before deployment.
# Generate a password without shell-sensitive characters, for example:
# openssl rand -hex 32

POSTGRES_DB=poetryapp
POSTGRES_USER=poetryapp
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password

# Public origin that will serve the Poetry App frontend.
# This is the planned hostname; do not change Cloudflare/Nginx yet.
CORS_ALLOWED_ORIGINS=https://workdone.qzz.io

# Use latest for initial deployment, or a specific sha-... image tag for pinning.
IMAGE_TAG=latest
